// Database schema for dog-stuff, in DBML.
// View it: paste this file into https://dbdiagram.io/d (documentation only, nothing is uploaded by the app).
// Source of truth: src/db/schema.ts + drizzle/*.sql. Keep this file in sync when the schema changes.

Project dog_stuff {
  database_type: 'PostgreSQL'
  Note: '''
  Booking and practice management for one PBMT practitioner.
  All timestamps are timestamptz (UTC). Money is integer ZAR cents.
  Ranges (tstzrange) are always bounded and half-open: [start, end).
  Nothing is hard-deleted from the UI: clients/pets are archived, appointments cancelled.
  '''
}

Enum service_kind {
  human
  animal
}

Enum appointment_status {
  booked
  done
  no_show
  cancelled
}

Enum booking_source {
  web [note: 'Public booking page']
  app [note: "Owner's app (phone bookings)"]
}

TableGroup people {
  client
  pet
}

TableGroup catalogue {
  service
  product
}

TableGroup scheduling {
  working_hours
  time_off
  appointment
  appointment_product
  settings
}

TableGroup auth {
  user
  session
  rate_limit
}

Table client {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  phone text [not null, note: 'Normalised E.164, e.g. +27821234567. Used to match returning clients.']
  email text
  notes text [not null, default: '']
  archived_at timestamptz [note: 'Set instead of deleting']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    `lower(name) gin_trgm_ops` [type: gin, name: 'client_name_trgm_idx', note: 'Contains-search on name (pg_trgm)']
    phone [name: 'client_phone_idx']
  }
}

Table pet {
  id uuid [pk, default: `gen_random_uuid()`]
  client_id uuid [not null, ref: > client.id]
  name text [not null]
  species text [not null]
  breed text
  notes text [not null, default: '']
  archived_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    client_id [name: 'pet_client_id_idx']
    (id, client_id) [unique, name: 'pet_id_client_id_key', note: 'Target of appointment composite FK']
  }
}

Table service {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  description text [not null, default: '']
  for_kind service_kind [not null]
  duration_min integer [not null, note: 'CHECK > 0']
  buffer_min integer [not null, default: 10, note: 'CHECK >= 0. Added after the session (cleanup).']
  price_cents integer [not null, note: 'CHECK >= 0']
  sort_order integer [not null, default: 0]
  active boolean [not null, default: true]
}

Table product {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  description text [not null, default: '']
  price_cents integer [not null, note: 'CHECK >= 0']
  sort_order integer [not null, default: 0]
  active boolean [not null, default: true]

  Note: 'Display only on the website; sold in person during a session.'
}

Table working_hours {
  id uuid [pk, default: `gen_random_uuid()`]
  weekday smallint [not null, note: '0 = Sunday … 6 = Saturday, business time zone. CHECK between 0 and 6']
  start_time time [not null]
  end_time time [not null, note: 'CHECK end_time > start_time']

  indexes {
    weekday [name: 'working_hours_weekday_idx']
  }
}

Table time_off {
  id uuid [pk, default: `gen_random_uuid()`]
  during tstzrange [not null, note: 'Bounded, non-empty']
  reason text
  created_at timestamptz [not null, default: `now()`]
  removed_at timestamptz [note: 'Set when removed; kept as a record, no longer blocks']

  indexes {
    during [type: gist, name: 'time_off_during_idx', note: 'Overlap lookups']
  }
}

Table appointment {
  id uuid [pk, default: `gen_random_uuid()`]
  client_id uuid [not null, ref: > client.id]
  pet_id uuid [note: 'NULL = the client is being treated. Must belong to client_id (composite FK).']
  service_id uuid [not null, ref: > service.id]
  during tstzrange [not null, note: 'Session + buffer. Bounded, non-empty.']
  status appointment_status [not null, default: 'booked']
  source booking_source [not null]
  notes text [not null, default: '']
  manage_token text [not null, unique, note: '32 random bytes, base64url. Private link for the client.']
  cancelled_at timestamptz [note: 'CHECK set exactly when status = cancelled']
  price_cents integer [not null, note: 'Service price when booked; CHECK >= 0']
  reminder_sent_at timestamptz [note: 'Day-before reminder sent (or claimed); never sent twice']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    `lower(during)` [name: 'appointment_during_start_idx']
    client_id [name: 'appointment_client_id_idx']
    pet_id [name: 'appointment_pet_id_idx']
  }

  Note: '''
  Double-booking guard (hand-written migrations 0002, 0004):
    EXCLUDE USING gist (during WITH &&) WHERE (status IN ('booked', 'done'))
  A done visit keeps its time; cancelled and no_show free it.
  Violations raise SQLSTATE 23P01, shown to users as "that time was just taken".
  '''
}

Table appointment_product {
  appointment_id uuid [not null, ref: > appointment.id]
  product_id uuid [not null, ref: > product.id]
  qty integer [not null, default: 1, note: 'CHECK > 0']
  price_cents integer [not null, note: 'Unit price at time of sale. CHECK >= 0']

  indexes {
    (appointment_id, product_id) [pk]
  }
}

Table settings {
  id smallint [pk, default: 1, note: 'CHECK id = 1 (single row)']
  business_name text [not null]
  contact_phone text [note: 'Shown in the site footer and emails']
  contact_email text
  address text
  min_notice_hours integer [not null, default: 12]
  max_days_ahead integer [not null, default: 42]
  slot_step_min integer [not null, default: 30]
  cancel_cutoff_hours integer [not null, default: 24]
}

Table user {
  id uuid [pk, default: `gen_random_uuid()`]
  email text [not null, note: 'Stored lower-cased']
  name text [not null]
  password_hash text [not null, note: 'argon2']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    `lower(email)` [unique, name: 'user_email_lower_idx', note: 'Unique regardless of case']
  }
}

Table session {
  id text [pk, note: 'SHA-256 hash of the cookie token; the token itself is never stored']
  user_id uuid [not null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id [name: 'session_user_id_idx']
  }
}

Table rate_limit {
  key text [not null, note: 'e.g. booking:<ip> or login:<ip>']
  window_start timestamptz [not null]
  count integer [not null, default: 0]

  indexes {
    (key, window_start) [pk]
  }
}

Ref appointment_pet_belongs_to_client: appointment.(pet_id, client_id) > pet.(id, client_id)
Ref: session.user_id > user.id [delete: cascade]
