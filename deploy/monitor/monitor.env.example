# Settings for check.sh on the second (backup) machine. Copy to monitor.env, fill in,
# and keep it private (chmod 600): it holds the SMTP password.

# The site to watch.
SITE_URL=https://bookings.example.com

# Where the server's backups arrive on this machine (the folder BACKUP_REMOTE points at).
# Leave empty to skip the backup check.
BACKUP_DIR=/home/backup/dogstuff-backups
MAX_BACKUP_AGE_HOURS=26

# Who to email, and how (the same Gmail account and app password as the server is fine).
ALERT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional: where check.sh remembers what is already down (default ~/.dogstuff-monitor).
# STATE_DIR=
