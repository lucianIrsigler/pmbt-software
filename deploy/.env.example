# Production settings. Copy to .env on the server (next to docker-compose.prod.yml) and
# fill in. Never commit the real file. See docs/RUNBOOK.md.

# --- Where the app lives ----------------------------------------------------------------
# The domain (its DNS A record must point at this server).
DOMAIN=bookings.example.co.za
# Public base URL, used in emails and booking links.
APP_URL=https://bookings.example.co.za

# --- Images (set by the deploy workflow; shown here for manual deploys) ------------------
# ghcr.io/<github owner>/<repo>, lower case
IMAGE_PREFIX=ghcr.io/owner/dog-stuff
IMAGE_TAG=latest

# --- Secrets ------------------------------------------------------------------------------
# Database password. Letters and digits only (it goes into a URL): openssl rand -hex 24
POSTGRES_PASSWORD=
# Scrambles client IP addresses for the rate limits (sessions do not use it).
# At least 32 random characters: openssl rand -base64 48
IP_HASH_SECRET=

# --- Email (Google account with an app password; see docs/RUNBOOK.md) ---------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Business -------------------------------------------------------------------------------
BUSINESS_TZ=Africa/Johannesburg
# Daily reminder emails (business time zone).
REMINDER_TIME=17:00

# --- Backups --------------------------------------------------------------------------------
# Cron schedule in the business time zone (default: 02:00 every night).
BACKUP_SCHEDULE=0 2 * * *
# Off-server copy over SSH, e.g. backup@backup.example.net:dogstuff-backups/
# Needs secrets/backup_ssh_key and secrets/known_hosts. Leave empty to keep backups local only.
BACKUP_REMOTE=

# --- Alerts ---------------------------------------------------------------------------------
# Who gets an email when a nightly backup fails (sent with the SMTP settings above).
# Leave empty for no alerts (not advised). Test: dc exec backup alert.sh test
ALERT_EMAIL=
