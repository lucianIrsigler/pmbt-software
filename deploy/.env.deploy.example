# Settings for deploy/deploy.sh on YOUR computer. Copy to deploy/.env.deploy (not committed).
# The server's own settings stay in its .env; this only says where the server is.

# SSH target: user@address, or a Host name from ~/.ssh/config.
DEPLOY_HOST=deploy@203.0.113.10
# The app folder on the server.
DEPLOY_PATH=/opt/daisyhealing
# The server's CPU type: linux/amd64 for most VPSs, linux/arm64 for ARM servers.
DEPLOY_PLATFORM=linux/amd64
