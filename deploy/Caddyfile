# HTTPS for the app. Caddy gets and renews a Let's Encrypt certificate for {$DOMAIN}
# automatically (the domain's DNS must point at this server, ports 80 and 443 open).
# For a local test, DOMAIN=localhost uses Caddy's own local certificate instead.

{$DOMAIN} {
	encode zstd gzip

	reverse_proxy web:3000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
}

# Visitors typing www. get the main address. Needs a DNS record for www. pointing at
# this server; remove this block if there isn't one (Caddy would keep failing to get a
# certificate for it).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
