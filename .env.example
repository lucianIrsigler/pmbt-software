# Copy to .env and fill in. Never commit .env.

# Matches docker-compose.dev.yml
DATABASE_URL=postgres://dogstuff:dogstuff@localhost:5432/dogstuff

# Public base URL, used in emails and manage links
APP_URL=http://localhost:3000

# At least 32 random characters, e.g.: openssl rand -base64 48
SESSION_SECRET=change-me-to-at-least-32-random-characters

# SMTP (required in production; in development emails are logged to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Google account: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<the address>,
# SMTP_PASS=<a Google "App password">, MAIL_FROM=<the same address>
# Tests only: write emails as JSON files to this folder instead of sending them
# EMAIL_OUTBOX_DIR=

BUSINESS_TZ=Africa/Johannesburg
